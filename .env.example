# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string. Used to encrypt the login cookie.
SECRET_KEY=
# Optional. Defaults to https://<your-host>/api/auth/callback
REDIRECT_URI=
# Only applications from this date on are read
SINCE=2026/05/01
